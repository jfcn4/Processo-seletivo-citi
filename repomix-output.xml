  border: 1px solid var(--line); background: rgba(255,255,255,.02); transition: border-color .2s, transform .2s;
}
.card:hover { border-color: var(--accent, var(--citi)); transform: translateY(-2px); }
.card .c-meta { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent, var(--citi)); }
.card strong { font-family: var(--f-display); font-size: 18px; font-weight: 600; }
.card span { color: var(--ink-dim); font-size: 14px; }

/* ---------- Intro ---------- */
#intro {
  position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; text-align: center;
  padding: env(safe-area-inset-top, 0px) max(20px, env(safe-area-inset-right, 0px)) env(safe-area-inset-bottom, 0px) max(20px, env(safe-area-inset-left, 0px));
  background: radial-gradient(90% 70% at 50% 42%, rgba(7, 20, 15, .25), rgba(5, 14, 10, .82) 75%);
  transition: opacity .7s ease, visibility .7s;
}
#intro.is-done { opacity: 0; visibility: hidden; pointer-events: none; }
.intro-inner { display: grid; justify-items: center; max-width: 560px; }
.intro-inner > * { opacity: 0; transform: translateY(10px); animation: rise 1s cubic-bezier(.2,.8,.2,1) forwards; }
.intro-logo { width: 96px; height: auto; margin-bottom: 30px; filter: drop-shadow(0 0 22px rgba(79,229,119,.35)); animation-delay: .15s !important; }
.intro-eyebrow { margin: 0 0 16px; font-family: var(--f-mono); font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--ink-dim); animation-delay: .45s !important; }
.intro-eyebrow b { color: var(--citi); font-weight: 500; }
.intro-name { margin: 0; font-family: var(--f-display); font-weight: 800; font-size: clamp(36px, 8vw, 64px); line-height: 1; letter-spacing: -.015em; text-wrap: balance; animation-delay: .6s !important; }
.intro-handle {
  margin: 16px 0 38px; padding: 4px 10px; border-radius: 8px; font-family: var(--f-mono); font-size: 13px; font-weight: 500; letter-spacing: .04em;
  color: var(--citi); background: var(--citi-soft); border: 1px solid rgba(79,229,119,.3); animation-delay: .75s !important;
}
.start {
  display: inline-flex; align-items: center; gap: 12px; padding: 15px 26px 15px 28px; border-radius: 999px;
  background: var(--citi); color: #04160c; font-family: var(--f-display); font-weight: 600; font-size: 14px; letter-spacing: .02em;
  animation: rise 1s .95s cubic-bezier(.2,.8,.2,1) forwards, beacon 2.6s 2s ease-out infinite !important;
  transition: transform .2s, filter .2s;
}
.start:hover { scale: 1.03; filter: brightness(1.06); }
.start:disabled { cursor: progress; filter: saturate(.4) brightness(.8); }
.start svg { transition: transform .2s; }
.start:hover svg { transform: translateX(3px); }
@keyframes beacon { 0% { box-shadow: 0 0 0 0 rgba(79,229,119,.5), 0 0 38px rgba(79,229,119,.32); } 100% { box-shadow: 0 0 0 20px rgba(79,229,119,0), 0 0 38px rgba(79,229,119,.32); } }
.intro-note { display: flex; align-items: center; gap: 8px; margin: 20px 0 0; font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); animation-delay: 1.1s !important; }
@keyframes rise { to { opacity: 1; transform: none; } }
#flash {
  position: fixed; inset: 0; z-index: 15; pointer-events: none; opacity: 0;
  background: radial-gradient(60% 60% at 50% 50%, rgba(225,255,232,.95), rgba(79,229,119,.45) 45%, rgba(79,229,119,0) 80%);
}
body:not(.is-live) .hud-top, body:not(.is-live) .hud-bottom { opacity: 0; pointer-events: none; }
body:not(.is-live) .hud-top * , body:not(.is-live) .hud-bottom * { pointer-events: none !important; }
.hud-top { transition: opacity 1s ease .2s; }
.pill-sound { display: inline-flex; align-items: center; gap: 9px; }
.eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
.eq i { width: 2px; height: 100%; border-radius: 1px; background: var(--citi); transform-origin: bottom; animation: eq 1.3s ease-in-out infinite; }
.eq i:nth-child(2) { animation-duration: 1.05s; animation-delay: -.4s; }
.eq i:nth-child(3) { animation-duration: 1.5s; animation-delay: -.8s; }
.eq i:nth-child(4) { animation-duration: 1.2s; animation-delay: -.2s; }
.pill-sound[aria-pressed="false"] .eq i { animation: none; transform: scaleY(.22); background: var(--ink-faint); }
@keyframes eq { 0%, 100% { transform: scaleY(.3); } 50% { transform: scaleY(1); } }
#con-label {
  position: fixed; left: 0; top: 0; z-index: 3; pointer-events: none; white-space: nowrap;
  font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .32em; text-transform: uppercase; color: var(--citi);
  text-shadow: 0 0 12px rgba(79,229,119,.6); opacity: 0; transition: opacity 1.2s ease;
}
#con-label.is-on { opacity: .9; }
body.is-focused #con-label { opacity: 0; }
#toast {
  position: fixed; z-index: 7; left: 50%; bottom: calc(96px + env(safe-area-inset-bottom, 0px));
  max-width: calc(100% - 32px); padding: 10px 18px; border-radius: 999px; text-align: center;
  font-family: var(--f-mono); font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink);
  background: var(--glass); border: 1px solid rgba(79,229,119,.45); box-shadow: 0 0 30px rgba(79,229,119,.18);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  opacity: 0; transform: translate(-50%, 10px); transition: opacity .5s, transform .5s; pointer-events: none;
}
#toast.is-on { opacity: 1; transform: translate(-50%, 0); }
.contact {
  display: flex; align-items: center; gap: 14px; padding: 14px; border-radius: 12px; text-decoration: none; color: var(--ink);
  border: 1px solid var(--line); background: rgba(255,255,255,.02); transition: border-color .2s, background .2s;
}
.contact:hover { border-color: rgba(79,229,119,.55); background: rgba(79,229,119,.06); }
.contact-ico { width: 40px; height: 40px; border-radius: 9px; display: grid; place-items: center; flex: none; font-family: var(--f-display); font-weight: 800; font-size: 16px; color: var(--citi); background: var(--citi-soft); border: 1px solid rgba(79,229,119,.3); }
.contact-meta { min-width: 0; flex: 1; }
.contact-meta strong { display: block; font-size: 14px; }
.contact-meta span { font-family: var(--f-mono); font-size: 11px; color: var(--ink-faint); overflow-wrap: anywhere; }
.contact svg { color: var(--ink-dim); flex: none; }
#fallback { position: fixed; inset: 0; display: grid; place-items: center; text-align: center; padding: 24px; z-index: 30; background: var(--space); }

@media (max-width: 720px) {
  .brand-text span { display: none; }
  .brand img { height: 22px; }
  .credit { display: none; }
  .hint { font-size: 10px; }
  #panel {
    top: auto; width: 100%; max-height: 72%; border-left: 0; border-top: 1px solid var(--line);
    border-radius: 22px 22px 0 0; transform: translateY(104%);
    padding: 18px max(20px, env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) max(20px, env(safe-area-inset-left, 0px));
  }
  .p-top { margin-bottom: 18px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-delay: 0s !important; transition-duration: .01ms !important; }
}

/* planilha */
.dx-sheet { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: rgba(0, 0, 0, .25); min-width: 0; }
.dx-sheet-tabs { display: flex; gap: 2px; padding: 8px 8px 0; background: rgba(255, 255, 255, .03); border-bottom: 1px solid var(--line); overflow-x: auto; }
.dx-sheet-tab { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 8px 8px 0 0; font-family: var(--f-mono); font-size: 12px; color: var(--ink-dim); white-space: nowrap; }
.dx-sheet-tab i { width: 9px; height: 9px; border-radius: 2px; background: var(--sw); }

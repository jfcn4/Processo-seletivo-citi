  }
  function setAba(t) {
    aba = t;
    root.querySelectorAll('[data-tab]').forEach(function (b) { b.setAttribute('aria-selected', b.dataset.tab === t ? 'true' : 'false'); });
    views = views.filter(function (fn) { return !fn.inOverlay; });
    var before = views.length;

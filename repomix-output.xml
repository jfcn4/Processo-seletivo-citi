<file path="entregas/dados.css">
/* Entrega de Dados: resumo no painel do planeta + visão expandida (dossiê) com as duas etapas.
   Etapa 1 usa o ciano do planeta Dados; Etapa 2 usa âmbar, para as duas nunca se confundirem. */
:root {
  --dx-s1: #52d6e0;
  --dx-s1-soft: rgba(82, 214, 224, .12);
  --dx-s2: #ffb454;
  --dx-s2-soft: rgba(255, 180, 84, .12);
  --dx-bg: rgba(4, 11, 8, .96);
  --dx-head: #0b1a14;
  --dx-ok: #4fe577;
  --dx-p-vazia: #9aa3ad;
  --dx-p-cidade: #b9a6ff;
  --dx-p-valor: #ff9f6e;
  --dx-p-data: #52d6e0;
  --dx-p-dup: #ff6b7d;
}

/* ---------- resumo no painel lateral ---------- */
.dx-answer { display: grid; gap: 4px; padding: 16px; border-radius: 14px; background: var(--dx-s1-soft); border: 1px solid rgba(82, 214, 224, .35); }
.dx-answer .dx-city { font-family: var(--f-display); font-weight: 800; font-size: 30px; line-height: 1.05; }
.dx-answer .dx-when { font-size: 15px; color: var(--ink); }
.dx-answer .dx-value { font-family: var(--f-mono); font-size: 13px; color: var(--dx-s1); font-variant-numeric: tabular-nums; }
.dx-mini { font-size: 13px; color: var(--ink-dim); margin: 0; }
.dx-stage-card {
  --c: var(--dx-s1);
  display: grid; gap: 4px; width: 100%; text-align: left; padding: 14px 14px 14px 16px; border-radius: 12px;
  border: 1px solid var(--line); background: rgba(255, 255, 255, .02); position: relative; overflow: hidden;
  transition: border-color .2s, background .2s;
}
.dx-stage-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); }
.dx-stage-card:hover { border-color: var(--c); background: rgba(255, 255, 255, .04); }
.dx-stage-card.is-s2 { --c: var(--dx-s2); }
.dx-stage-card .dx-n { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c); }
.dx-stage-card strong { font-family: var(--f-display); font-weight: 600; font-size: 15px; }
.dx-stage-card span.dx-d { font-size: 13px; color: var(--ink-dim); }
.dx-expand {
  display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 14px; border-radius: 12px;
  background: var(--citi); color: #04160c; font-family: var(--f-display); font-weight: 600; font-size: 14px;
  transition: filter .2s, transform .2s;
}
.dx-expand:hover { filter: brightness(1.07); transform: translateY(-1px); }

/* ---------- visão expandida ---------- */
#dx {
  --st: var(--dx-s1); --st-soft: var(--dx-s1-soft);
  position: fixed; inset: 0; z-index: 40; display: flex; flex-direction: column;
  background: var(--dx-bg); color: var(--ink);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  opacity: 0; transition: opacity .3s ease;
}
#dx[hidden] { display: none !important; }
#dx.is-open { opacity: 1; }
#dx[data-stage="2"] { --st: var(--dx-s2); --st-soft: var(--dx-s2-soft); }
#dx button { cursor: pointer; }
.dx-top {
  flex: none; border-bottom: 1px solid var(--line); background: rgba(6, 18, 13, .9);
  padding: calc(14px + env(safe-area-inset-top, 0px)) max(20px, env(safe-area-inset-right, 0px)) 0 max(20px, env(safe-area-inset-left, 0px));
}
.dx-top-row, .dx-stages, .dx-wrap { max-width: 1200px; margin-inline: auto; }
.dx-top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.dx-eyebrow { font-family: var(--f-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--dx-s1); }
.dx-title { font-family: var(--f-display); font-weight: 800; font-size: clamp(18px, 2.4vw, 26px); line-height: 1.15; margin: 6px 0 0; text-wrap: balance; }
.dx-top-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
.dx-btn {
  display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line);
  font-family: var(--f-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink);
  background: rgba(255, 255, 255, .03); text-decoration: none; white-space: nowrap; transition: border-color .2s, background .2s;
}
.dx-btn:hover { border-color: rgba(79, 229, 119, .55); background: rgba(79, 229, 119, .08); }
.dx-stages { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 16px; }
.dx-stage-tab {
  --c: var(--dx-s1); --cs: var(--dx-s1-soft);
  position: relative; display: grid; gap: 3px; text-align: left; padding: 12px 16px 15px; border-radius: 12px 12px 0 0;
  border: 1px solid var(--line); border-bottom: 0; background: rgba(255, 255, 255, .015); color: var(--ink-dim);
  transition: background .2s, color .2s;
}
.dx-stage-tab.is-s2 { --c: var(--dx-s2); --cs: var(--dx-s2-soft); }
.dx-stage-tab::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--c); opacity: .2; transition: opacity .2s; }
.dx-stage-tab[aria-selected="true"] { background: var(--cs); color: var(--ink); }
.dx-stage-tab[aria-selected="true"]::after { opacity: 1; }
.dx-stage-tab .dx-n { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c); }
.dx-stage-tab strong { font-family: var(--f-display); font-weight: 600; font-size: 15px; }
.dx-stage-tab .dx-t { font-size: 12.5px; color: var(--ink-faint); }

.dx-body {
  flex: 1; overflow-y: auto; overscroll-behavior: contain;
  padding: 24px max(20px, env(safe-area-inset-right, 0px)) calc(48px + env(safe-area-inset-bottom, 0px)) max(20px, env(safe-area-inset-left, 0px));
}
.dx-wrap { display: grid; gap: 22px; }
.dx-card { min-width: 0; padding: 20px; border-radius: 16px; border: 1px solid var(--line); background: rgba(255, 255, 255, .025); }
.dx-label { font-family: var(--f-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 10px; }
.dx-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 16px; }
.dx-hero-main { background: var(--st-soft); border-color: color-mix(in srgb, var(--st) 40%, transparent); display: grid; gap: 10px; align-content: start; }
.dx-big { font-family: var(--f-display); font-weight: 800; font-size: clamp(30px, 4.6vw, 48px); line-height: 1.02; margin: 0; text-wrap: balance; }
.dx-big em { font-style: normal; color: var(--st); }
.dx-big-sm { font-size: clamp(24px, 3vw, 32px); }
.dx-answer-big { font-size: clamp(24px, 3.2vw, 34px); line-height: 1.25; }
.dx-answer-big mark {
  color: var(--dx-s1); background: rgba(82, 214, 224, .14); padding: 0 .28em; border-radius: 8px;
  box-shadow: inset 0 0 0 1px rgba(82, 214, 224, .5), 0 0 24px rgba(82, 214, 224, .25);
}
.dx-hero-main.is-answer { border-color: var(--dx-s1); box-shadow: 0 0 0 1px rgba(82, 214, 224, .35), 0 0 48px rgba(82, 214, 224, .16); }
.dx-hero-main.is-answer .dx-label { color: var(--dx-s1); }
.dx-lead { font-size: 15px; color: var(--ink-dim); margin: 0; max-width: 60ch; }
.dx-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.dx-stat { padding: 14px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255, 255, 255, .02); display: grid; gap: 2px; }
.dx-stat b { font-family: var(--f-display); font-weight: 600; font-size: 22px; font-variant-numeric: tabular-nums; }
.dx-stat span { font-size: 12.5px; color: var(--ink-dim); }
.dx-callout { padding: 14px 16px; border-radius: 12px; border-left: 3px solid var(--st); background: rgba(255, 255, 255, .03); font-size: 14px; color: var(--ink-dim); }
.dx-callout strong { color: var(--ink); }

/* fluxo Bronze → Prata → Ouro */
.dx-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.dx-step {
  --m: #c58a52; position: relative; display: grid; gap: 4px; text-align: left; padding: 14px 16px; border-radius: 12px;
  border: 1px solid var(--line); background: rgba(255, 255, 255, .02); transition: border-color .2s, background .2s;
}

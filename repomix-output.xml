  starMat.uniforms.uTime.value = REDUCED ? 0 : t;
  starGroup.rotation.y = t * 0.0018;
  flares.forEach(function (f) { var u = f.userData; f.material.opacity = REDUCED ? u.base * 0.7 : u.base * (0.35 + 0.65 * Math.max(0, Math.sin(t * u.sp + u.ph))); });

ribute(\"transform\", `translate(${planta.x.toFixed(1)} ${planta.y}) scale(${planta.escala.toFixed(3)})`);\n      planta.giro.setAttribute(\"transform\", `rotate(${(balanco + planta.inclinacao + tremor + caido).toFixed(2)})`);\n      for (const folha of planta.folhas) {\n        const agito = Math.sin(t / 110 + folha.fase * 3) * 3.5 * planta.agito;\n        const angulo = folha.angulo + Math.sin(t / 1100 + folha.fase) * folha.amplitude + agito;\n        folha.no.setAttribute(\"transform\", `rotate(${angulo.toFixed(2)})`);\n      }\n    }\n\n    sol.setAttribute(\"opacity\", (0.85 + Math.sin(t / 4000) * 0.15).toFixed(3));\n    for (const polen of polens) {\n      polen.y -= polen.velocidade;\n      if (polen.y < 40) polen.y = CHAO - 10;\n      const x = polen.x + Math.sin(t / 2600 + polen.fase) * 14;\n      polen.no.setAttribute(\"cx\", x.toFixed(1));\n      polen.no.setAttribute(\"cy\", polen.y.toFixed(1));\n      polen.no.setAttribute(\"opacity\", (0.35 + 0.35 * Math.sin(t / 900 + polen.fase)).toFixed(2));\n    }\n\n    for (let i = quedas.length - 1; i >= 0; i--) {\n      const queda = quedas[i];\n      const idade = performance.now() - queda.nascimento - queda.atraso;\n      if (idade < 0) continue;\n      const progresso = idade / 2600;\n      const y = queda.inicioY + (CHAO - queda.inicioY) * Math.min(progresso, 1);\n      const x = queda.x + Math.sin(idade / 300 + queda.fase) * 18;\n      queda.no.setAttribute(\"transform\", `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${(queda.giro + idade / 8).toFixed(1)})`);\n      queda.no.setAttribute(\"opacity\", progresso < 0.8 ? 1 : Math.max(0, (1.2 - progresso) / 0.4).toFixed(2));\n      if (progresso >= 1.2) {\n        queda.no.remove();\n        quedas.splice(i, 1);\n      }\n    }\n  }\n\n  let visivel = true;\n  new IntersectionObserver(([entrada]) => (visivel = entrada.isIntersecting)).observe(secao);\n\n  function laco(t) {\n    if (visivel && !movimentoReduzido.matches) quadro(t);\n    requestAnimationFrame(laco);\n  }\n  requestAnimationFrame(laco);\n\n  // ---------- Som ambiente (Web Audio) ----------\n\n  const Som = (() => {\n    let ctx = null;\n    let mestre = null;\n    let eco = null;\n    let ligado = false;\n    let proximoPassaro = null;\n    let ruidoFolhas = null;\n    let ultimoFarfalhar = 0;\n\n    function ruidoMarrom(segundos) {\n      const buffer = ctx.createBuffer(1, ctx.sampleRate * segundos, ctx.sampleRate);\n      const dados = buffer.getChannelData(0);\n      let ultimo = 0;\n      for (let i = 0; i < dados.length; i++) {\n        ultimo = (ultimo + 0.02 * (Math.random() * 2 - 1)) / 1.02;\n        dados[i] = ultimo * 3.5;\n      }\n      return buffer;\n    }\n\n    function lfo(frequencia, profundidade, destino) {\n      const osc = ctx.createOscillator();\n      const ganho = ctx.createGain();\n      osc.frequency.value = frequencia;\n      ganho.gain.value = profundidade;\n      osc.connect(ganho).connect(destino);\n      osc.start();\n    }\n\n    function montar() {\n      ctx = new (window.AudioContext || window.webkitAudioContext)();\n      mestre = ctx.createGain();\n      mestre.gain.value = 0;\n      mestre.connect(ctx.destination);\n\n      // Eco suave, para dar sensação de espaço aberto\n      eco = ctx.createDelay(1);\n      eco.delayTime.value = 0.32;\n      const filtroEco = ctx.createBiquadFilter();\n      filtroEco.type = \"lowpass\";\n      filtroEco.frequency.value = 2200;\n      const retorno = ctx.createGain();\n      retorno.gain.value = 0.35;\n      eco.connect(filtroEco).connect(retorno);\n      retorno.connect(eco);\n      retorno.connect(mestre);\n\n      // Vento: ruído grave filtrado, subindo e descendo devagar\n      const vento = ctx.createBufferSource();\n      vento.buffer = ruidoMarrom(4);\n      vento.loop = true;\n      const filtroVento = ctx.createBiquadFilter();\n      filtroVento.type = \"lowpass\";\n      filtroVento.frequency.value = 520;\n      const volumeVento = ctx.createGain();\n      volumeVento.gain.value = 0.16;\n      vento.connect(filtroVento).connect(volumeVento).connect(mestre);\n      lfo(0.07, 0.07, volumeVento.gain);\n      lfo(0.045, 240, filtroVento.frequency);\n      vento.start();\n\n      // Fundo musical: um acorde aberto em Ré, bem baixo e respirando\n      const filtroPad = ctx.createBiquadFilter();\n      filtroPad.type = \"lowpass\";\n      filtroPad.frequency.value = 750;\n      const volumePad = ctx.createGain();\n      volumePad.gain.value = 0.5;\n      filtroPad.connect(volumePad);\n      volumePad.connect(mestre);\n      volumePad.connect(eco);\n      [146.83, 220, 293.66, 329.63, 369.99].forEach((frequencia, i) => {\n        const osc = ctx.createOscillator();\n        osc.type = i % 2 === 0 ? \"sine\" : \"triangle\";\n        osc.frequency.value = frequencia;\n        osc.detune.value = (i - 2) * 4;\n        const voz = ctx.createGain();\n        voz.gain.value = 0.011;\n        osc.connect(voz).connect(filtroPad);\n        lfo(0.05 + i * 0.017, 0.008, voz.gain);\n        osc.start();\n      });\n    }\n\n    function nota(frequencia, inicio, duracao, volume, tipo = \"sine\") {\n      const osc = ctx.createOscillator();\n      const ganho = ctx.createGain();\n      osc.type = tipo;\n      osc.frequency.value = frequencia;\n      ganho.gain.setValueAtTime(0, inicio);\n      ganho.gain.linearRampToValueAtTime(volume, inicio + 0.015);\n      ganho.gain.exponentialRampToValueAtTime(0.0001, inicio + duracao);\n      osc.connect(ganho);\n      ganho.connect(mestre);\n      ganho.connect(eco);\n      osc.start(inicio);\n      osc.stop(inicio + duracao + 0.05);\n      return osc;\n    }\n\n    function passaro() {\n      const posicao = ctx.createStereoPanner ? ctx.createStereoPanner() : null;\n      const base = 2300 + Math.random() * 1400;\n      const pios = 2 + Math.floor(Math.random() * 4);\n      let t = ctx.currentTime + 0.05;\n      for (let i = 0; i < pios; i++) {\n        const osc = ctx.createOscillator();\n        const ganho = ctx.createGain();\n        osc.frequency.setValueAtTime(base, t);\n        osc.frequency.exponentialRampToValueAtTime(base * 1.35, t + 0.06);\n        osc.frequency.exponentialRampToValueAtTime(base * 0.9, t + 0.13);\n        ganho.gain.setValueAtTime(0, t);\n        ganho.gain.linearRampToValueAtTime(0.009, t + 0.012);\n        ganho.gain.exponentialRampToValueAtTime(0.0001, t + 0.15);\n        osc.connect(ganho);\n        if (posicao) {\n          posicao.pan.value = Math.random() * 1.6 - 0.8;\n          ganho.connect(posicao);\n        } else {\n          ganho.connect(mestre);\n        }\n        osc.start(t);\n        osc.stop(t + 0.2);\n        t += 0.17 + Math.random() * 0.12;\n      }\n      if (posicao) {\n        posicao.connect(mestre);\n        posicao.connect(eco);\n      }\n      proximoPassaro = setTimeout(passaro, 7000 + Math.random() * 12000);\n    }\n\n    function alternar() {\n      if (!ctx) montar();\n      ligado = !ligado;\n      if (ligado) {\n        ctx.resume();\n        mestre.gain.setTargetAtTime(0.45, ctx.currentTime, 1.2);\n        proximoPassaro = setTimeout(passaro, 4000);\n      } else {\n        mestre.gain.setTargetAtTime(0, ctx.currentTime, 0.4);\n        clearTimeout(proximoPassaro);\n      }\n      return ligado;\n    }\n\n    document.addEventListener(\"visibilitychange\", () => {\n      if (!ctx || !ligado) return;\n      if (document.hidden) ctx.suspend();\n      else ctx.resume();\n    });\n\n    return {\n      alternar,\n      // Folhas roçando: um sopro curto de ruído agudo, bem baixinho\n      farfalhar() {\n        if (!ligado || ctx.currentTime - ultimoFarfalhar < 0.15) return;\n        ultimoFarfalhar = ctx.currentTime;\n        if (!ruidoFolhas) {\n          ruidoFolhas = ctx.createBuffer(1, ctx.sampleRate * 0.5, ctx.sampleRate);\n          const dados = ruidoFolhas.getChannelData(0);\n          for (let i = 0; i < dados.length; i++) dados[i] = Math.random() * 2 - 1;\n        }\n        const fonte = ctx.createBufferSource();\n        fonte.buffer = ruidoFolhas;\n        fonte.playbackRate.value = 0.8 + Math.random() * 0.4;\n        const filtro = ctx.createBiquadFilter();\n        filtro.type = \"bandpass\";\n        filtro.frequency.value = 2600 + Math.random() * 1800;\n        filtro.Q.value = 0.9;\n        const ganho = ctx.createGain();\n        const t = ctx.currentTime;\n        ganho.gain.setValueAtTime(0, t);\n        ganho.gain.linearRampToValueAtTime(0.05, t + 0.05);\n        ganho.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);\n        fonte.connect(filtro).connect(ganho).connect(mestre);\n        fonte.start(t);\n        fonte.stop(t + 0.45);\n      },\n      // Sininho de venda: duas notas que somem devagar\n      sino() {\n        if (!ligado) return;\n        const t = ctx.currentTime;\n        nota(1046.5, t, 1.8, 0.025);\n        nota(1318.5, t + 0.09, 2.2, 0.018);\n      },\n      // Venda recusada: um \"tum\" grave e curto\n      negado() {\n        if (!ligado) return;\n        nota(196, ctx.currentTime, 0.45, 0.03, \"triangle\");\n      },\n    };\n  })();\n\n  const botoes = document.createElement(\"div\");\n  botoes.className = \"jardim-botoes\";\n  secao.appendChild(botoes);\n\n  const botaoSom = document.createElement(\"button\");\n  botaoSom.type = \"button\";\n  botaoSom.className = \"jardim-botao\";\n  botaoSom.setAttribute(\"aria-pressed\", \"false\");\n  botaoSom.textContent = \"🔈 Sons da floresta\";\n  botaoSom.addEventListener(\"click\", () => {\n    const ligado = Som.alternar();\n    botaoSom.setAttribute(\"aria-pressed\", String(ligado));\n    botaoSom.textContent = `${ligado ? \"🔊\" : \"🔈\"} Sons da floresta`;\n  });\n  botoes.appendChild(botaoSom);\n\n  // Tela cheia: o jardim ocupa a tela inteira, e as plantas ficam maiores\n  if (document.fullscreenEnabled) {\n    const botaoTela = document.createElement(\"button\");\n    botaoTela.type = \"button\";\n    botaoTela.className = \"jardim-botao jardim-botao-tela\";\n    botaoTela.textContent = \"⤢ Tela cheia\";\n    botaoTela.addEventListener(\"click\", () => {\n      if (document.fullscreenElement) document.exitFullscreen();\n      else secao.requestFullscreen();\n    });\n    document.addEventListener(\"fullscreenchange\", () => {\n      botaoTela.textContent = document.fullscreenElement === secao ? \"✕ Sair da tela cheia\" : \"⤢ Tela cheia\";\n      esconderDica();\n    });\n    botoes.appendChild(botaoTela);\n  }\n\n  window.Jardim = { atualizar, vendeu, recusou };\n})();"}, {"path": "requests.http", "lang": "http", "content": "@base = http://localhost:3001\n\n### Cadastrar planta válida (201)\nPOST {{base}}/plantas\nContent-Type: application/json\n\n{\n  \"nome\": \"Costela-de-adão\",\n  \"especie\": \"Monstera deliciosa\",\n  \"preco\": 8990,\n  \"estoque\": 12,\n  \"luminosidade\": \"MEIA_SOMBRA\",\n  \"petFriendly\": false,\n  \"regaACadaDias\": 3\n}\n\n### Cadastrar com estoque 0 e petFriendly false (201)\nPOST {{base}}/plantas\nContent-Type: application/json\n\n{\n  \"nome\": \"Calathea\",\n  \"especie\": \"Goeppertia orbifolia\",\n  \"preco\": 7990,\n  \"estoque\": 0,\n  \"luminosidade\": \"SOMBRA\",\n  \"petFriendly\": false,\n  \"regaACadaDias\": 3\n}\n\n### Cadastrar com preco em texto (400)\nPOST {{base}}/plantas\nContent-Type: application/json\n\n{\n  \"nome\": \"Jiboia\",\n  \"especie\": \"Epipremnum aureum\",\n  \"preco\": \"8990\",\n  \"estoque\": 5,\n  \"luminosidade\": \"SOMBRA\",\n  \"petFriendly\": false,\n  \"regaACadaDias\": 4\n}\n\n### Cadastrar com luminosidade inválida (400)\nPOST {{base}}/plantas\nContent-Type: application/json\n\n{\n  \"nome\": \"Jiboia\",\n  \"especie\": \"Epipremnum aureum\",\n  \"preco\": 3490,\n  \"estoque\": 5,\n  \"luminosidade\": \"LUA\",\n  \"petFriendly\": false,\n  \"regaACadaDias\": 4\n}\n\n### Listar todas (200)\nGET {{base}}/plantas\n\n### Filtrar por luminosidade e petFriendly (200)\nGET {{base}}/plantas?luminosidade=MEIA_SOMBRA&petFriendly=false\n\n### Filtro inválido (400)\nGET {{base}}/plantas?luminosidade=LUA\n\n### Bônus: busca por nome e ordenação (200)\nGET {{base}}/plantas?nome=costela&ordem=preco\n\n### Buscar por id (200)\nGET {{base}}/plantas/1\n\n### Buscar id inexistente (404)\nGET {{base}}/plantas/9999\n\n### Buscar id inválido (400)\nGET {{base}}/plantas/abc\n\n### Editar só o preço (200)\nPATCH {{base}}/plantas/1\nContent-Type: application/json\n\n{ \"preco\": 9990 }\n\n### Editar com valor inválido (400)\nPATCH {{base}}/plantas/1\nContent-Type: application/json\n\n{ \"estoque\": -1 }\n\n### Vender (200)\nPOST {{base}}/plantas/1/venda\nContent-Type: application/json\n\n{ \"quantidade\": 2 }\n\n### Vender mais do que tem (400)\nPOST {{base}}/plantas/1/venda\nContent-Type: application/json\n\n{ \"quantidade\": 999 }\n\n### Vender quantidade 0 (400)\nPOST {{base}}/plantas/1/venda\nContent-Type: application/json\n\n{ \"quantidade\": 0 }\n\n### Valor total do estoque (200)\nGET {{base}}/plantas/estoque/valor-total\n\n### Deletar (204)\nDELETE {{base}}/plantas/1\n\n### Deletar de novo (404)\nDELETE {{base}}/plantas/1\n\n### JSON malformado (400)\nPOST {{base}}/plantas\nContent-Type: application/json\n\n{ \"nome\": \"Jiboia\", }\n\n### Bônus: plantas esgotadas (200)\nGET {{base}}/plantas/esgotadas"}, {"path": "src/app.ts", "lang": "ts", "content": "import express, { NextFunction, Request, Response } from \"express\";\nimport path from \"path\";\nimport routes from \"./routes\";\n\nconst app = express();\n\napp.use(express.json());\n\n// Painel web da loja (HTML, CSS e JS da pasta public/), acessível em /loja\napp.use(\"/loja\", express.static(path.resolve(__dirname, \"..\", \"public\")));\n\napp.use(routes);\n\n// Qualquer rota que não existe cai aqui\napp.use((req, res) => {\n  res.status(404).json({ message: \"Rota não encontrada\" });\n});\n\n// Erros que acontecem antes de chegar nas rotas, como um corpo que não é JSON válido.\n// O Express só reconhece um middleware de erro pelos 4 parâmetros, por isso o _next fica\napp.use((error: { type?: string }, _req: Request, res: Response, _next: NextFunction) => {\n  if (error.type === \"entity.parse.failed\") {\n    res.status(400).json({ message: \"O corpo da requisição não é um JSON válido.\" });\n    return;\n  }\n\n  console.error(error);\n  res.status(500).json({ message: \"Erro interno do servidor.\" });\n});\n\nexport default app;"}, {"path": "src/controllers/PlantaController.ts", "lang": "ts", "content": "import { Request, Response } from \"express\";\nimport { Luminosidade } from \"@prisma/client\";\nimport * as PlantaRepository from \"@repositories/PlantaRepository\";\nimport { FiltrosPlanta } from \"@repositories/PlantaRepository\";\n\ntype DadosPlanta = {\n  nome?: string;\n  especie?: string;\n  preco?: number;\n  estoque?: number;\n  luminosidade?: Luminosidade;\n  petFriendly?: boolean;\n  regaACadaDias?: number;\n};\n\ntype ErroValidacao = { campo: string; message: string };\n\nconst CAMPOS_PLANTA = [\n  \"nome\",\n  \"especie\",\n  \"preco\",\n  \"estoque\",\n  \"luminosidade\",\n  \"petFriendly\",\n  \"regaACadaDias\",\n] as const;\n\nconst LUMINOSIDADES = Object.values(Luminosidade) as string[];\n\n// Maior valor que cabe numa coluna Int do PostgreSQL. Acima disso o banco\n// recusaria o valor e o erro viraria um 500, quando o problema é do cliente (400).\nconst MAIOR_INT_DO_BANCO = 2147483647;\n\n// ---------- Validações ----------\n\nconst ehTextoValido = (valor: unknown): valor is string => {\n  return typeof valor === \"string\" && valor.trim() !== \"\";\n};\n\n// Number.isInteger recusa \"8990\" (texto), 89.9 (decimal) e NaN\nconst ehInteiro = (valor: unknown): valor is number => {\n  return Number.isInteger(valor);\n};\n\nconst validarCampo = (campo: string, valor: unknown): string | null => {\n  if (ehInteiro(valor) && valor > MAIOR_INT_DO_BANCO) {\n    return `${campo} deve ser no máximo ${MAIOR_INT_DO_BANCO}.`;\n  }\n\n  switch (campo) {\n    case \"nome\":\n    case \"especie\":\n      return ehTextoValido(valor) ? null : `${campo} deve ser um texto não vazio.`;\n    case \"preco\":\n      return ehInteiro(valor) && valor > 0\n        ? null\n        : \"preco deve ser um inteiro maior que zero (valor em centavos).\";\n    case \"estoque\":\n      return ehInteiro(valor) && valor >= 0\n        ? null\n        : \"estoque deve ser um inteiro maior ou igual a zero.\";\n    case \"regaACadaDias\":\n      return ehInteiro(valor) && valor >= 1\n        ? null\n        : \"regaACadaDias deve ser um inteiro maior ou igual a 1.\";\n    case \"luminosidade\":\n      return typeof valor === \"string\" && LUMINOSIDADES.includes(valor)\n        ? null\n        : `luminosidade deve ser um destes valores: ${LUMINOSIDADES.join(\", \")}.`;\n    case \"petFriendly\":\n      return typeof valor === \"boolean\" ? null : \"petFriendly deve ser true ou false.\";\n    default:\n      return null;\n  }\n};\n\n// Serve para o cadastro e para a edição. A presença do campo é checada com\n// === undefined, e não com !campo, porque !0 e !false são verdadeiros:\n// !campo recusaria estoque 0 e plantas que não são pet-friendly.\n// - parcial = false (POST): todos os campos são obrigatórios\n// - parcial = true (PATCH): nenhum é obrigatório, mas os enviados seguem as mesmas regras\nconst validarPlanta = (\n  body: Record<string, unknown>,\n  parcial: boolean\n): ErroValidacao | null => {\n  for (const campo of CAMPOS_PLANTA) {\n    const valor = body[campo];\n\n    if (valor === undefined) {\n      if (parcial) continue;\n      return { campo, message: `O campo ${campo} é obrigatório.` };\n    }\n\n    const erro = validarCampo(campo, valor);\n    if (erro) return { campo, message: erro };\n  }\n\n  return null;\n};\n\n// Pega só os campos da planta: qualquer outro campo do body (id, createdAt...) é ignorado\nconst extrairDadosPlanta = (body: Record<string, unknown>): DadosPlanta => {\n  const { nome, especie, preco, estoque, luminosidade, petFriendly, regaACadaDias } =\n    body as DadosPlanta;\n\n  return {\n    nome: typeof nome === \"string\" ? nome.trim() : undefined,\n    especie: typeof especie === \"string\" ? especie.trim() : undefined,\n    preco: preco,\n    estoque: estoque,\n    luminosidade: luminosidade,\n    petFriendly: petFriendly,\n    regaACadaDias: regaACadaDias,\n  };\n};\n\n// Garante que o body é um objeto, mesmo quando a requisição chega sem corpo\nconst lerBody = (req: Request): Record<string, unknown> => {\n  const body = req.body;\n  if (typeof body !== \"object\" || body === null || Array.isArray(body)) return {};\n  return body as Record<string, unknown>;\n};\n\n// O :id chega da URL como texto. Retorna o número ou null se for inválido (\"abc\", \"0\", \"1.5\")\nconst parseId = (valor: unknown): number | null => {\n  if (typeof valor !== \"string\") return null;\n  const id = Number(valor);\n  return Number.isInteger(id) && id > 0 && id <= MAIOR_INT_DO_BANCO ? id : null;\n};\n\n// Os filtros de req.query são sempre texto: \"true\" e \"false\" viram boolean, e um\n// filtro não enviado continua undefined (e não false), para não filtrar sem querer\nconst lerFiltros = (query: Request[\"query\"]): FiltrosPlanta | ErroValidacao => {\n  const { luminosidade, petFriendly, nome, ordem } = query;\n  const filtros: FiltrosPlanta = {};\n\n  if (luminosidade !== undefined) {\n    if (typeof luminosidade !== \"string\" || !LUMINOSIDADES.includes(luminosidade)) {\n      return {\n        campo: \"luminosidade\",\n        message: `Filtro luminosidade inválido. Use: ${LUMINOSIDADES.join(\", \")}.`,\n      };\n    }\n    filtros.luminosidade = luminosidade as Luminosidade;\n  }\n\n  if (petFriendly !== undefined) {\n    if (petFriendly !== \"true\" && petFriendly !== \"false\") {\n      return { campo: \"petFriendly\", message: \"Filtro petFriendly deve ser true ou false.\" };\n    }\n    filtros.petFriendly = petFriendly === \"true\";\n  }\n\n  if (nome !== undefined) {\n    if (!ehTextoValido(nome)) {\n      return { campo: \"nome\", message: \"Filtro nome deve ser um texto não vazio.\" };\n    }\n    filtros.nome = nome.trim();\n  }\n\n  if (ordem !== undefined) {\n    if (ordem !== \"preco\" && ordem !== \"nome\") {\n      return { campo: \"ordem\", message: \"Filtro ordem deve ser preco ou nome.\" };\n    }\n    filtros.ordem = ordem;\n  }\n\n  return filtros;\n};\n\nconst ehErro = (valor: FiltrosPlanta | ErroValidacao): valor is ErroValidacao => {\n  return \"message\" in valor;\n};\n\nconst ID_INVALIDO = { campo: \"id\", message: \"O id deve ser um inteiro positivo.\" };\n\nconst plantaNaoEncontrada = (id: number) => ({\n  message: `Planta com id ${id} não encontrada.`,\n});\n\n// ---------- Handlers ----------\n\nexport const createPlanta = async (req: Request, res: Response) => {\n  try {\n    const body = lerBody(req);\n\n    const erro = validarPlanta(body, false);\n    if (erro) {\n      return res.status(400).json(erro);\n    }\n\n    const dados = extrairDadosPlanta(body) as Required<DadosPlanta>;\n    const planta = await PlantaRepository.createPlanta(dados);\n\n    return res.status(201).json(planta);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao cadastrar planta.\" });\n  }\n};\n\nexport const readAllPlantas = async (req: Request, res: Response) => {\n  try {\n    const filtros = lerFiltros(req.query);\n    if (ehErro(filtros)) {\n      return res.status(400).json(filtros);\n    }\n\n    // Filtro válido sem resultado responde 200 com [], nunca 404\n    const plantas = await PlantaRepository.findAllPlantas(filtros);\n\n    return res.status(200).json(plantas);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao buscar plantas.\" });\n  }\n};\n\nexport const readPlantasEsgotadas = async (_req: Request, res: Response) => {\n  try {\n    const plantas = await PlantaRepository.findPlantasEsgotadas();\n\n    return res.status(200).json(plantas);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao buscar plantas esgotadas.\" });\n  }\n};\n\nexport const readPlantaById = async (req: Request, res: Response) => {\n  try {\n    const id = parseId(req.params.id);\n    if (id === null) {\n      return res.status(400).json(ID_INVALIDO);\n    }\n\n    const planta = await PlantaRepository.findPlantaById(id);\n    if (!planta) {\n      return res.status(404).json(plantaNaoEncontrada(id));\n    }\n\n    return res.status(200).json(planta);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao buscar planta.\" });\n  }\n};\n\nexport const updatePlanta = async (req: Request, res: Response) => {\n  try {\n    const id = parseId(req.params.id);\n    if (id === null) {\n      return res.status(400).json(ID_INVALIDO);\n    }\n\n    const body = lerBody(req);\n    const enviouAlgumCampo = CAMPOS_PLANTA.some((campo) => body[campo] !== undefined);\n    if (!enviouAlgumCampo) {\n      return res.status(400).json({ message: \"Nenhum campo válido para atualizar.\" });\n    }\n\n    const erro = validarPlanta(body, true);\n    if (erro) {\n      return res.status(400).json(erro);\n    }\n\n    // Antes de editar, garantimos que a planta existe; sem isso, o erro do Prisma viraria 500\n    const planta = await PlantaRepository.findPlantaById(id);\n    if (!planta) {\n      return res.status(404).json(plantaNaoEncontrada(id));\n    }\n\n    // Campos não enviados (undefined) não são alterados\n    const plantaAtualizada = await PlantaRepository.updatePlanta(id, extrairDadosPlanta(body));\n\n    return res.status(200).json(plantaAtualizada);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao atualizar planta.\" });\n  }\n};\n\nexport const deletePlanta = async (req: Request, res: Response) => {\n  try {\n    const id = parseId(req.params.id);\n    if (id === null) {\n      return res.status(400).json(ID_INVALIDO);\n    }\n\n    const planta = await PlantaRepository.findPlantaById(id);\n    if (!planta) {\n      return res.status(404).json(plantaNaoEncontrada(id));\n    }\n\n    await PlantaRepository.deletePlanta(id);\n\n    return res.status(204).send();\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao deletar planta.\" });\n  }\n};\n\nexport const venderPlanta = async (req: Request, res: Response) => {\n  try {\n    const id = parseId(req.params.id);\n    if (id === null) {\n      return res.status(400).json(ID_INVALIDO);\n    }\n\n    const { quantidade } = lerBody(req);\n    if (!ehInteiro(quantidade) || quantidade <= 0 || quantidade > MAIOR_INT_DO_BANCO) {\n      return res.status(400).json({\n        campo: \"quantidade\",\n        message: \"quantidade deve ser um inteiro maior que zero.\",\n      });\n    }\n\n    const planta = await PlantaRepository.findPlantaById(id);\n    if (!planta) {\n      return res.status(404).json(plantaNaoEncontrada(id));\n    }\n\n    const vendeu = await PlantaRepository.venderPlanta(id, quantidade);\n    if (!vendeu) {\n      // Busca de novo: outra venda pode ter mudado o estoque nesse meio-tempo\n      const atual = await PlantaRepository.findPlantaById(id);\n      const disponivel = atual ? atual.estoque : 0;\n      return res.status(400).json({\n        campo: \"quantidade\",\n        message: `Estoque insuficiente: temos só ${disponivel} ${disponivel === 1 ? \"vaso\" : \"vasos\"} de ${planta.nome}.`,\n      });\n    }\n\n    const plantaAtualizada = await PlantaRepository.findPlantaById(id);\n\n    return res.status(200).json(plantaAtualizada);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao registrar venda.\" });\n  }\n};\n\n// O aggregate do Prisma soma uma coluna, mas não preco × estoque,\n// então buscamos só esses dois campos e fazemos a conta aqui\nexport const readValorTotalEstoque = async (_req: Request, res: Response) => {\n  try {\n    const plantas = await PlantaRepository.findPrecoEEstoque();\n\n    const resumo = plantas.reduce(\n      (total, planta) => ({\n        valorTotalEmCentavos: total.valorTotalEmCentavos + planta.preco * planta.estoque,\n        totalDeVasos: total.totalDeVasos + planta.estoque,\n      }),\n      { valorTotalEmCentavos: 0, totalDeVasos: 0 }\n    );\n\n    return res.status(200).json(resumo);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao calcular o valor do estoque.\" });\n  }\n};"}, {"path": "src/controllers/UserController.ts", "lang": "ts", "content": "import { Request, Response } from \"express\";\nimport * as UserRepository from \"@repositories/UserRepository\";\n\n// O controller recebe a requisição, valida os dados, chama o repository\n// e decide qual status HTTP e qual corpo devolver.\n\nexport const createUser = async (req: Request, res: Response) => {\n  try {\n    const { nome, conta, documento } = req.body;\n\n    // 400 Bad Request: o cliente mandou dados incompletos\n    if (!nome || !conta || !documento) {\n      return res.status(400).json({\n        message: \"Preencha nome, conta e documento.\",\n      });\n    }\n\n    const user = await UserRepository.createUser({\n      nome: nome,\n      conta: conta,\n      documento: documento,\n    });\n\n    // 201 Created: algo novo foi criado\n    return res.status(201).json(user);\n  } catch (error) {\n    console.error(error);\n    // 500 Internal Server Error: o problema foi nosso, não do cliente\n    return res.status(500).json({ message: \"Erro ao criar usuário.\" });\n  }\n};\n\nexport const readAllUsers = async (req: Request, res: Response) => {\n  try {\n    const users = await UserRepository.findAllUsers();\n\n    return res.status(200).json(users);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao buscar usuários.\" });\n  }\n};\n\nexport const readUserById = async (req: Request, res: Response) => {\n  try {\n    // O id chega da URL como texto, então convertemos para número\n    const id = Number(req.params.id);\n\n    const user = await UserRepository.findUserById(id);\n\n    // 404 Not Found: o id não existe\n    if (!user) {\n      return res.status(404).json({ message: \"Usuário não encontrado.\" });\n    }\n\n    return res.status(200).json(user);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao buscar usuário.\" });\n  }\n};\n\nexport const updateUser = async (req: Request, res: Response) => {\n  try {\n    const id = Number(req.params.id);\n    const { nome, conta, documento } = req.body;\n\n    // Antes de editar, garantimos que o usuário existe\n    const user = await UserRepository.findUserById(id);\n\n    if (!user) {\n      return res.status(404).json({ message: \"Usuário não encontrado.\" });\n    }\n\n    // PATCH = atualização parcial: campos não enviados (undefined) não são alterados\n    const updatedUser = await UserRepository.updateUser(id, {\n      nome: nome,\n      conta: conta,\n      documento: documento,\n    });\n\n    return res.status(200).json(updatedUser);\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao atualizar usuário.\" });\n  }\n};\n\nexport const deleteUser = async (req: Request, res: Response) => {\n  try {\n    const id = Number(req.params.id);\n\n    const user = await UserRepository.findUserById(id);\n\n    if (!user) {\n      return res.status(404).json({ message: \"Usuário não encontrado.\" });\n    }\n\n    await UserRepository.deleteUser(id);\n\n    // 204 No Content: deu certo e não há nada para devolver\n    return res.status(204).send();\n  } catch (error) {\n    console.error(error);\n    return res.status(500).json({ message: \"Erro ao deletar usuário.\" });\n  }\n};"}, {"path": "src/database/index.ts", "lang": "ts", "content": "import { PrismaClient } from \"@prisma/client\";\n\nconst prisma = new PrismaClient();\n\nprisma\n  .$connect()\n  .then(() => {\n    console.log(\"📦 Successfully connected with database\");\n  })\n  .catch((error) => {\n    console.log(\"❌ Error connecting to database\", error);\n  });\n\nexport default prisma;"}, {"path": "src/repositories/PlantaRepository.ts", "lang": "ts", "content": "import { Luminosidade, Prisma } from \"@prisma/client\";\nimport prisma from \"@database\";\n\nexport type FiltrosPlanta = {\n    luminosidade?: Luminosidade;\n    petFriendly?: boolean;\n    nome?: string;\n    ordem?: \"preco\" | \"nome\";\n};\n\nexport const createPlanta = async (data: Prisma.PlantaCreateInput) => {\n    return await prisma.planta.create({\n        data: data,\n    });\n};\n\n// Filtros com valor undefined são ignorados pelo Prisma,\n// então uma única consulta atende qualquer combinação de filtros\nexport const findAllPlantas = async (filtros: FiltrosPlanta) => {\n    return await prisma.planta.findMany({\n        where: {\n            luminosidade: filtros.luminosidade,\n            petFriendly: filtros.petFriendly,\n            nome: filtros.nome\n                ? { contains: filtros.nome, mode: \"insensitive\" }\n                : undefined,\n        },\n        orderBy: filtros.ordem ? { [filtros.ordem]: \"asc\" } : { id: \"asc\" },\n    });\n};\n\nexport const findPlantasEsgotadas = async () => {\n    return await prisma.planta.findMany({\n        where: { estoque: 0 },\n        orderBy: { id: \"asc\" },\n    });\n};\n\nexport const findPlantaById = async (id: number) => {\n    return await prisma.planta.findUnique({\n        where: { id: id }\n    });\n};\n\nexport const updatePlanta = async (id: number, data: Prisma.PlantaUpdateInput) => {\n    return await prisma.planta.update({\n        where: { id: id },\n        data: data,\n    });\n};\n\nexport const deletePlanta = async (id: number) => {\n    return await prisma.planta.delete({\n        where: { id: id }\n    });\n};\n\n// A conferência do estoque fica no próprio where: o banco só decrementa\n// se ainda houver vasos suficientes, numa única operação. Assim duas vendas\n// simultâneas do último vaso não conseguem deixar o estoque negativo.\n// Retorna true se vendeu e false se o estoque não era suficiente.\nexport const venderPlanta = async (id: number, quantidade: number) => {\n    const resultado = await prisma.planta.updateMany({\n        where: { id: id, estoque: { gte: quantidade } },\n        data: { estoque: { decrement: quantidade } },\n    });\n\n    return resultado.count > 0;\n};\n\nexport const findPrecoEEstoque = async () => {\n    return await prisma.planta.findMany({\n        select: { preco: true, estoque: true },\n    });\n};"}, {"path": "src/repositories/UserRepository.ts", "lang": "ts", "content": "import { Prisma } from \"@prisma/client\";\nimport prisma from \"@database\";\n\nexport const createUser = async (data: Prisma.UserCreateInput) => {\n    return await prisma.user.create({\n        data: data,\n    });\n};\n\nexport const findAllUsers = async () => {\n    return await prisma.user.findMany();\n};\n\nexport const findUserById = async (id: number) => {\n    return await prisma.user.findUnique({\n        where: { id: id }\n    });\n};\n\nexport const updateUser = async (id: number, data: Prisma.UserUpdateInput) => {\n    return await prisma.user.update({\n        where: { id: id },\n        data: data,\n    });\n};\n\nexport const deleteUser = async (id: number) => {\n    return await prisma.user.delete({\n        where: { id: id }\n    });\n};"}, {"path": "src/routes.ts", "lang": "ts", "content": "import express from \"express\";\nimport * as UserController from \"@controllers/UserController\";\nimport * as PlantaController from \"@controllers/PlantaController\";\n\nconst routes = express.Router();\n\nroutes.get(\"/\", (req, res) => {\n  res.status(200).json({ message: \"API do treinamento de CRUD do CITi 🚀\" });\n});\n\n// CRUD de usuários\nroutes.post(\"/users\", UserController.createUser);\nroutes.get(\"/users\", UserController.readAllUsers);\nroutes.get(\"/users/:id\", UserController.readUserById);\nroutes.patch(\"/users/:id\", UserController.updateUser);\nroutes.delete(\"/users/:id\", UserController.deleteUser);\n\n// Plantas: as rotas fixas vêm antes de /plantas/:id, porque o Express usa a\n// primeira rota que combinar e \"esgotadas\" seria tratado como um id\nroutes.post(\"/plantas\", PlantaController.createPlanta);\nroutes.get(\"/plantas\", PlantaController.readAllPlantas);\nroutes.get(\"/plantas/esgotadas\", PlantaController.readPlantasEsgotadas);\nroutes.get(\"/plantas/estoque/valor-total\", PlantaController.readValorTotalEstoque);\nroutes.get(\"/plantas/:id\", PlantaController.readPlantaById);\nroutes.patch(\"/plantas/:id\", PlantaController.updatePlanta);\nroutes.delete(\"/plantas/:id\", PlantaController.deletePlanta);\nroutes.post(\"/plantas/:id/venda\", PlantaController.venderPlanta);\n\nexport default routes;"}, {"path": "src/server.ts", "lang": "ts", "content": "import \"dotenv/config\";\nimport app from \"./app\";\n\nconst port = process.env.SERVER_PORT || 3001;\n\napp.listen(port, () => {\n  console.log(`🚀 Server running on port ${port}`);\n});"}, {"path": "tests/plantas.test.ts", "lang": "ts", "content": "import request from \"supertest\";\nimport { afterAll, beforeEach, describe, expect, it } from \"vitest\";\nimport app from \"../src/app\";\nimport prisma from \"../src/database\";\n\nconst plantaValida = {\n  nome: \"Costela-de-adão\",\n  especie: \"Monstera deliciosa\",\n  preco: 8990,\n  estoque: 12,\n  luminosidade: \"MEIA_SOMBRA\",\n  petFriendly: false,\n  regaACadaDias: 3,\n};\n\nasync function criarPlanta(dados: Partial<typeof plantaValida> = {}) {\n  const res = await request(app)\n    .post(\"/plantas\")\n    .send({ ...plantaValida, ...dados });\n  return res.body;\n}\n\nbeforeEach(async () => {\n  await prisma.$executeRawUnsafe('TRUNCATE TABLE \"Planta\" RESTART IDENTITY');\n});\n\nafterAll(async () => {\n  await prisma.$disconnect();\n});\n\ndescribe(\"POST /plantas\", () => {\n  it(\"cadastra uma planta válida (201)\", async () => {\n    const res = await request(app).post(\"/plantas\").send(plantaValida);\n    expect(res.status).toBe(201);\n    expect(res.body).toMatchObject(plantaValida);\n    expect(res.body.id).toBeTypeOf(\"number\");\n  });\n\n  it(\"aceita estoque 0 e petFriendly false (201)\", async () => {\n    const res = await request(app)\n      .post(\"/plantas\")\n      .send({ ...plantaValida, estoque: 0, petFriendly: false });\n    expect(res.status).toBe(201);\n    expect(res.body.estoque).toBe(0);\n    expect(res.body.petFriendly).toBe(false);\n  });\n\n  it.each([\n    [\"sem um campo\", { nome: undefined }],\n    [\"preco 0\", { preco: 0 }],\n    [\"estoque -1\", { estoque: -1 }],\n    [\"preco como texto\", { preco: \"8990\" }],\n    [\"preco decimal\", { preco: 89.9 }],\n    [\"luminosidade fora do enum\", { luminosidade: \"LUA\" }],\n    [\"regaACadaDias 0\", { regaACadaDias: 0 }],\n    [\"nome vazio\", { nome: \"   \" }],\n    [\"petFriendly como texto\", { petFriendly: \"true\" }],\n  ])(\"recusa cadastro %s (400)\", async (_, alteracao) => {\n    const res = await request(app)\n      .post(\"/plantas\")\n      .send({ ...plantaValida, ...alteracao });\n    expect(res.status).toBe(400);\n    expect(res.body.message).toBeTypeOf(\"string\");\n  });\n\n  it(\"ignora campos desconhecidos no body\", async () => {\n    const res = await request(app)\n      .post(\"/plantas\")\n      .send({ ...plantaValida, id: 999, hackeado: true });\n    expect(res.status).toBe(201);\n    expect(res.body.id).not.toBe(999);\n    expect(res.body.hackeado).toBeUndefined();\n  });\n});\n\ndescribe(\"GET /plantas/:id\", () => {\n  it(\"busca uma planta existente (200)\", async () => {\n    const planta = await criarPlanta();\n    const res = await request(app).get(`/plantas/${planta.id}`);\n    expect(res.status).toBe(200);\n    expect(res.body.nome).toBe(plantaValida.nome);\n  });\n\n  it(\"retorna 404 para id inexistente\", async () => {\n    const res = await request(app).get(\"/plantas/9999\");\n    expect(res.status).toBe(404);\n  });\n\n  it.each([\"abc\", \"0\", \"-1\", \"1.5\"])(\"retorna 400 para id %s\", async (id) => {\n    const res = await request(app).get(`/plantas/${id}`);\n    expect(res.status).toBe(400);\n  });\n});\n\ndescribe(\"PATCH /plantas/:id\", () => {\n  it(\"edita só o preço, sem mudar o resto (200)\", async () => {\n    const planta = await criarPlanta();\n    const res = await request(app).patch(`/plantas/${planta.id}`).send({ preco: 9990 });\n    expect(res.status).toBe(200);\n    expect(res.body.preco).toBe(9990);\n    expect(res.body.nome).toBe(planta.nome);\n    expect(res.body.estoque).toBe(planta.estoque);\n  });\n\n  it(\"recusa valor inválido (400)\", async () => {\n    const planta = await criarPlanta();\n    const res = await request(app).patch(`/plantas/${planta.id}`).send({ preco: -5 });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"recusa body sem nenhum campo válido (400)\", async () => {\n    const planta = await criarPlanta();\n    const res = await request(app).patch(`/plantas/${planta.id}`).send({});\n    expect(res.status).toBe(400);\n  });\n\n  it(\"retorna 404 para id inexistente\", async () => {\n    const res = await request(app).patch(\"/plantas/9999\").send({ preco: 100 });\n    expect(res.status).toBe(404);\n  });\n});\n\ndescribe(\"GET /plantas (filtros)\", () => {\n  beforeEach(async () => {\n    await criarPlanta({ nome: \"Jiboia\", luminosidade: \"SOMBRA\", petFriendly: false, preco: 3000 });\n    await criarPlanta({ nome: \"Maranta\", luminosidade: \"MEIA_SOMBRA\", petFriendly: true, preco: 5000 });\n    await criarPlanta({ nome: \"Alecrim\", luminosidade: \"SOL_PLENO\", petFriendly: true, preco: 1500 });\n  });\n\n  it(\"lista todas sem filtro (200)\", async () => {\n    const res = await request(app).get(\"/plantas\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(3);\n  });\n\n  it(\"filtra por luminosidade\", async () => {\n    const res = await request(app).get(\"/plantas?luminosidade=SOMBRA\");\n    expect(res.status).toBe(200);\n    expect(res.body.map((p: { nome: string }) => p.nome)).toEqual([\"Jiboia\"]);\n  });\n\n  it(\"filtra por petFriendly=false sem confundir com filtro ausente\", async () => {\n    const res = await request(app).get(\"/plantas?petFriendly=false\");\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(1);\n  });\n\n  it(\"filtra pelos dois juntos\", async () => {\n    const res = await request(app).get(\"/plantas?luminosidade=SOL_PLENO&petFriendly=true\");\n    expect(res.status).toBe(200);\n    expect(res.body.map((p: { nome: string }) => p.nome)).toEqual([\"Alecrim\"]);\n  });\n\n  it(\"filtro válido sem resultado retorna 200 com []\", async () => {\n    const res = await request(app).get(\"/plantas?luminosidade=SOMBRA&petFriendly=true\");\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual([]);\n  });\n\n  it.each([\"luminosidade=LUA\", \"petFriendly=sim\", \"ordem=estoque\"])(\n    \"filtro inválido %s retorna 400\",\n    async (query) => {\n      const res = await request(app).get(`/plantas?${query}`);\n      expect(res.status).toBe(400);\n    }\n  );\n\n  it(\"busca por nome sem diferenciar maiúsculas (bônus)\", async () => {\n    const res = await request(app).get(\"/plantas?nome=MARAN\");\n    expect(res.status).toBe(200);\n    expect(res.body.map((p: { nome: string }) => p.nome)).toEqual([\"Maranta\"]);\n  });\n\n  it(\"ordena por preço e por nome (bônus)\", async () => {\n    const porPreco = await request(app).get(\"/plantas?ordem=preco\");\n    expect(porPreco.body.map((p: { preco: number }) => p.preco)).toEqual([1500, 3000, 5000]);\n\n    const porNome = await request(app).get(\"/plantas?ordem=nome\");\n    expect(porNome.body.map((p: { nome: string }) => p.nome)).toEqual([\n      \"Alecrim\",\n      \"Jiboia\",\n      \"Maranta\",\n    ]);\n  });\n});\n\ndescribe(\"POST /plantas/:id/venda\", () => {\n  it(\"vende o que tem (200) e diminui o estoque\", async () => {\n    const planta = await criarPlanta({ estoque: 5 });\n    const res = await request(app).post(`/plantas/${planta.id}/venda`).send({ quantidade: 2 });\n    expect(res.status).toBe(200);\n    expect(res.body.estoque).toBe(3);\n  });\n\n  it(\"recusa vender mais do que tem (400) sem alterar o estoque\", async () => {\n    const planta = await criarPlanta({ estoque: 2 });\n    const res = await request(app).post(`/plantas/${planta.id}/venda`).send({ quantidade: 3 });\n    expect(res.status).toBe(400);\n\n    const depois = await request(app).get(`/plantas/${planta.id}`);\n    expect(depois.body.estoque).toBe(2);\n  });\n\n  it.each([0, -1, 1.5, \"2\"])(\"recusa quantidade %s (400)\", async (quantidade) => {\n    const planta = await criarPlanta();\n    const res = await request(app).post(`/plantas/${planta.id}/venda`).send({ quantidade });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"retorna 404 para planta inexistente\", async () => {\n    const res = await request(app).post(\"/plantas/9999/venda\").send({ quantidade: 1 });\n    expect(res.status).toBe(404);\n  });\n\n  it(\"duas vendas simultâneas do último vaso: só uma passa\", async () => {\n    const planta = await criarPlanta({ estoque: 1 });\n\n    const [a, b] = await Promise.all([\n      request(app).post(`/plantas/${planta.id}/venda`).send({ quantidade: 1 }),\n      request(app).post(`/plantas/${planta.id}/venda`).send({ quantidade: 1 }),\n    ]);\n\n    expect([a.status, b.status].sort()).toEqual([200, 400]);\n\n    const depois = await request(app).get(`/plantas/${planta.id}`);\n    expect(depois.body.estoque).toBe(0);\n  });\n});\n\ndescribe(\"GET /plantas/estoque/valor-total\", () => {\n  it(\"retorna zeros com a loja vazia (200)\", async () => {\n    const res = await request(app).get(\"/plantas/estoque/valor-total\");\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual({ valorTotalEmCentavos: 0, totalDeVasos: 0 });\n  });\n\n  it(\"soma preco × estoque e o total de vasos\", async () => {\n    await criarPlanta({ preco: 8990, estoque: 12 });\n    await criarPlanta({ preco: 2500, estoque: 4 });\n    await criarPlanta({ preco: 4000, estoque: 0 });\n\n    const res = await request(app).get(\"/plantas/estoque/valor-total\");\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual({\n      valorTotalEmCentavos: 8990 * 12 + 2500 * 4,\n      totalDeVasos: 16,\n    });\n  });\n});\n\ndescribe(\"GET /plantas/esgotadas (bônus)\", () => {\n  it(\"lista só as plantas com estoque zero\", async () => {\n    await criarPlanta({ nome: \"Com estoque\", estoque: 3 });\n    await criarPlanta({ nome: \"Esgotada\", estoque: 0 });\n\n    const res = await request(app).get(\"/plantas/esgotadas\");\n    expect(res.status).toBe(200);\n    expect(res.body.map((p: { nome: string }) => p.nome)).toEqual([\"Esgotada\"]);\n  });\n});\n\ndescribe(\"casos de borda\", () => {\n  it(\"JSON malformado retorna 400 com mensagem em JSON\", async () => {\n    const res = await request(app)\n      .post(\"/plantas\")\n      .set(\"Content-Type\", \"application/json\")\n      .send('{\"nome\": \"x\",');\n    expect(res.status).toBe(400);\n    expect(res.body.message).toBeTypeOf(\"string\");\n  });\n\n  it.each([\"preco\", \"estoque\", \"regaACadaDias\"])(\n    \"%s acima do limite do banco retorna 400, não 500\",\n    async (campo) => {\n      const res = await request(app)\n        .post(\"/plantas\")\n        .send({ ...plantaValida, [campo]: 99999999999 });\n      expect(res.status).toBe(400);\n      expect(res.body.campo).toBe(campo);\n    }\n  );\n\n  it(\"id acima do limite do banco retorna 400, não 500\", async () => {\n    const res = await request(app).get(\"/plantas/99999999999\");\n    expect(res.status).toBe(400);\n  });\n\n  it(\"quantidade acima do limite do banco retorna 400, não 500\", async () => {\n    const planta = await criarPlanta();\n    const res = await request(app)\n      .post(`/plantas/${planta.id}/venda`)\n      .send({ quantidade: 99999999999 });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"rota inexistente retorna 404 em JSON\", async () => {\n    const res = await request(app).get(\"/plantinhas\");\n    expect(res.status).toBe(404);\n    expect(res.body.message).toBeTypeOf(\"string\");\n  });\n});\n\ndescribe(\"DELETE /plantas/:id\", () => {\n  it(\"deleta (204), depois busca (404) e deleta de novo (404)\", async () => {\n    const planta = await criarPlanta();\n\n    const del = await request(app).delete(`/plantas/${planta.id}`);\n    expect(del.status).toBe(204);\n\n    const busca = await request(app).get(`/plantas/${planta.id}`);\n    expect(busca.status).toBe(404);\n\n    const delDeNovo = await request(app).delete(`/plantas/${planta.id}`);\n    expect(delDeNovo.status).toBe(404);\n  });\n});"}, {"path": "tests/setup-global.ts", "lang": "ts", "content": "import { execSync } from \"child_process\";\n\n// Roda uma vez antes de todos os testes: recria o banco de teste do zero e aplica\n// as migrations. O yarn test troca o DATABASE_DB para \"treinamento-crud-test\",\n// então o banco de desenvolvimento nunca é tocado.\nexport default function setup() {\n  if (!process.env.DATABASE_DB?.endsWith(\"-test\")) {\n    throw new Error(\"Rode os testes com yarn test, que usa o banco treinamento-crud-test.\");\n  }\n\n  execSync(\"prisma migrate reset --force --skip-seed --skip-generate\", {\n    stdio: \"inherit\",\n  });\n}"}, {"path": "tsconfig.json", "lang": "json", "content": "{\n  \"compilerOptions\": {\n    \"target\": \"es2020\",\n    \"module\": \"commonjs\",\n    \"moduleResolution\": \"node\",\n    \"lib\": [\"ES2020\"],\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"removeComments\": true,\n    \"esModuleInterop\": true,\n    \"resolveJsonModule\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true,\n    \"strict\": true,\n    \"baseUrl\": \"./\",\n    \"paths\": {\n      \"@controllers/*\": [\"./src/controllers/*\"],\n      \"@repositories/*\": [\"./src/repositories/*\"],\n      \"@database\": [\"./src/database\"]\n    }\n  },\n  \"include\": [\"src/**/*\"]\n}"}, {"path": "vitest.config.ts", "lang": "ts", "content": "import path from \"path\";\nimport { defineConfig } from \"vitest/config\";\n\nexport default defineConfig({\n  resolve: {\n    // Os mesmos atalhos de import do tsconfig.json (@controllers, @repositories, @database)\n    alias: {\n      \"@controllers\": path.resolve(\"src/controllers\"),\n      \"@repositories\": path.resolve(\"src/repositories\"),\n      \"@database\": path.resolve(\"src/database\"),\n    },\n  },\n  test: {\n    globalSetup: \"./tests/setup-global.ts\",\n    // Os testes compartilham o mesmo banco, então rodam um arquivo de cada vez\n    fileParallelism: false,\n  },\n});"}]};

  clearTimeout(toastTimer); toastTimer = setTimeout(function () { toastEl.classList.remove('is-on'); }, 4200);
}
function conNear(x, y, px) {
  var W = window.innerWidth, H = window.innerHeight;
  for (var i = 0; i < constellation.world.length; i++) {
    conV.copy(constellation.world[i]).project(camera);
    if (conV.z > 1) continue;
    if (Math.hypot((conV.x * 0.5 + 0.5) * W - x, (-conV.y * 0.5 + 0.5) * H - y) < px) return true;
  }
  return false;
}
function conOnScreen() {
  conV.copy(constellation.grp.position).project(camera);
  return conV.z < 1 && Math.abs(conV.x) < 0.75 && Math.abs(conV.y) < 0.8;
}
function revealConstellation(byUser) {
  var c = constellation;
  if (byUser && !c.found) { c.found = true; showToast('Você encontrou a constelação do CITi'); }
  if (c.phase === 'draw') return;
  if (c.phase === 'hold') { c.t = 0; return; }
  c.phase = 'draw'; c.t = 0; c.lit.fill(0); Sound.constellation();
}
function updateConstellation(dt, t) {
  var c = constellation, free = state.mode === 'free' && !state.focus && listEl.hidden;
  if (c.phase === 'idle') {
    if (free) c.wait -= dt;
    if (c.wait <= 0 && free && conOnScreen()) revealConstellation(false);
  }
  if (c.hovering && free) { c.hoverT += dt; if (c.hoverT > 0.35) revealConstellation(true); } else c.hoverT = 0;
  c.t += dt;
  var lineOp = 0, glow = 0, drawT = c.phase === 'draw' ? c.t : 1e9;
  if (c.phase === 'draw') { lineOp = 0.9; glow = 1; if (c.t > CON_SEG.length * DRAW_STEP + DRAW_SEG) { c.phase = 'hold'; c.t = 0; } }
  else if (c.phase === 'hold') { lineOp = 0.9; glow = 1; if (c.t > HOLD) { c.phase = 'fade'; c.t = 0; } }
  else if (c.phase === 'fade') {

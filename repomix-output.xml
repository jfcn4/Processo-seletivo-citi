/* =========================================================
   Botão de som
   ========================================================= */
var btnSound = document.getElementById('btn-sound');
function syncSoundBtn() {
  var on = Sound.isOn();
  btnSound.setAttribute('aria-pressed', on ? 'true' : 'false');
  btnSound.setAttribute('aria-label', on ? 'Desligar som' : 'Ligar som');
  btnSound.querySelector('.snd-txt').textContent = on ? 'Som' : 'Mudo';
}
if (!Sound.available) btnSound.hidden = true;
else {
  syncSoundBtn();
  btnSound.addEventListener('click', function () { Sound.setOn(!Sound.isOn(), state.mode !== 'intro' && state.mode !== 'warp'); syncSoundBtn(); });
}

/* =========================================================
   Loop
   ========================================================= */
var clock = new THREE.Clock(), goalPos = new THREE.Vector3(), goalTarget = new THREE.Vector3(), proj = new THREE.Vector3();
function damp(k, dt) { return 1 - Math.exp(-k * dt); }

function tick() {
  // com uma entrega aberta em tela cheia, o sistema solar fica escondido atrás dela: pausa o 3D e poupa o computador
  if (document.querySelector('#dx:not([hidden]), #mk:not([hidden]), #dv:not([hidden]), #gg:not([hidden])')) { clock.getDelta(); requestAnimationFrame(tick); return; }
  var dt = Math.min(clock.getDelta(), 0.05), t = clock.elapsedTime;
  state.timeScale += ((state.focus ? 0.04 : 1) - state.timeScale) * damp(2.5, dt);
  // as órbitas ficam paradas na tela de início, para a posição na chegada ser sempre a mesma
  state.sim += dt * state.timeScale * (REDUCED ? 0.35 : 1) * (state.mode === 'intro' ? 0 : 1);

  sunMat.uniforms.uTime.value = t;
  var pulse = REDUCED ? 1 : 1 + Math.sin(t * 1.7) * 0.035;
  coronaA.scale.setScalar(SUN_R * 4.4 * pulse);
  coronaB.material.opacity = 0.42 + Math.sin(t * 0.9) * 0.08;
  sun.rotation.y = t * 0.04;
  // o Sol também cresce um pouco com o cursor em cima, como os planetas
  var ss = state.hover === 'sol' ? 1.08 : 1;
  sunGroup.scale.lerp(tmpV.set(ss, ss, ss), damp(8, dt));

  BODIES.forEach(function (b) {
    if (b.sun) return;
    orbitPos(b.orbit, b.phase + state.sim * SPEEDS[b.orbit], b.holder.position);
    b.mesh.rotation.y = t * 0.12;
    b.mesh.material.uniforms.uTime.value = t;
    var s = state.hover === b.key ? 1.12 : 1;
    b.holder.scale.lerp(tmpV.set(s, s, s), damp(8, dt));
    var tgGlow = (state.hover === b.key || navHover === b.key || state.focus === b.key) ? 1 : 0;
    b.glow += (tgGlow - b.glow) * damp(6, dt);
    var om = b.orbitLine.material;
    om.opacity = 0.1 + 0.1 * b.wake + 0.5 * b.glow;
    om.color.copy(CITI_C).lerp(b.orbitColor, b.glow);
    updateWaking(b, dt, t);
  });

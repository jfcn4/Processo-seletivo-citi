    if (conV.z < 1) conLabel.style.transform = 'translate(' + ((conV.x * 0.5 + 0.5) * window.innerWidth) + 'px,' + ((-conV.y * 0.5 + 0.5) * window.innerHeight) + 'px) translate(-50%, -50%)';
    else showLabel = false;

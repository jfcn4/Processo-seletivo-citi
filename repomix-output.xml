    x.addEventListener('click', function () { abrir('balanca'); });
    container.appendChild(x);
  }

  window.CITI_ENTREGAS = window.CITI_ENTREGAS || {};
  window.CITI_ENTREGAS.marketing = { painel: painel, abrir: abrir };
})();

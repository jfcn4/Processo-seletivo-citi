<file path="entregas/marketing.css">
/* Entrega de Marketing: resumo no painel, balança de pesos, gráficos e PDF, com visão em tela cheia.
   Cores de setor (validadas para o fundo escuro e para daltonismo): Varejo coral, Indústria azul. */
:root {
  --mk-acc: #ff7a8a;              /* cor do planeta Marketing */
  --mk-acc-soft: rgba(255, 122, 138, .12);
  --mk-v: #e65f50;                /* Varejo */
  --mk-i: #4a8ce0;                /* Indústria */
  --mk-grid: rgba(146, 230, 170, .12);
  --mk-bg: rgba(4, 11, 8, .96);
  --mk-head: #0b1a14;
}

/* ---------- painel lateral ---------- */
.mk-answer { display: grid; gap: 6px; padding: 16px; border-radius: 14px; background: var(--mk-acc-soft); border: 1px solid rgba(255, 122, 138, .4); }
.mk-answer strong { font-family: var(--f-display); font-weight: 800; font-size: 24px; line-height: 1.15; text-wrap: balance; }
.mk-answer span { font-size: 13.5px; color: var(--ink-dim); }
.mk-sub { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 16px; color: var(--ink); }
.mk-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.mk-btn {
  display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line);
  font-family: var(--f-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink);
  background: rgba(255, 255, 255, .03); text-decoration: none; white-space: nowrap; cursor: pointer; transition: border-color .2s, background .2s;
}
.mk-btn:hover { border-color: rgba(79, 229, 119, .55); background: rgba(79, 229, 119, .08); }
.mk-btn.is-main { background: var(--citi); color: #04160c; border-color: var(--citi); font-weight: 600; }
.mk-btn.is-main:hover { filter: brightness(1.07); }
.mk-expand {
  display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 14px; border-radius: 12px;
  background: var(--citi); color: #04160c; font-family: var(--f-display); font-weight: 600; font-size: 14px; cursor: pointer;
  transition: filter .2s, transform .2s;
}
.mk-expand:hover { filter: brightness(1.07); transform: translateY(-1px); }

/* ---------- PDF ---------- */
.mk-pdf { position: relative; border: 1px solid var(--line); border-radius: 12px; background: #1b1f1d; overflow: auto; overscroll-behavior: contain; }
.mk-pdf.is-compact { height: 380px; }
.mk-pdf.is-full { max-height: none; background: transparent; border: 0; overflow: visible; }
.mk-pdf-pages { display: grid; gap: 12px; padding: 12px; justify-items: center; }
.mk-pdf.is-full .mk-pdf-pages { padding: 0; gap: 18px; }
.mk-pdf canvas { display: block; width: 100%; max-width: 860px; height: auto; border-radius: 4px; background: #fff; box-shadow: 0 6px 24px rgba(0, 0, 0, .35); }
.mk-pdf-msg { padding: 32px 16px; text-align: center; font-size: 13.5px; color: var(--ink-dim); }

/* ---------- balança ---------- */
.mk-bal { display: grid; gap: 16px; }
.mk-bal.is-big { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: start; gap: 24px; }
.mk-bal-left { display: grid; gap: 14px; min-width: 0; }
.mk-stage { border: 1px solid var(--line); border-radius: 14px; background: rgba(0, 0, 0, .22); padding: 8px 8px 4px; }
.mk-stage svg { display: block; width: 100%; height: auto; max-width: 100%; }
.mk-beam, .mk-pan { transition: transform .6s cubic-bezier(.3, 1.3, .5, 1); }
.mk-pan .plate { transition: fill .3s, filter .3s; }
.mk-pan.is-win .plate { filter: drop-shadow(0 0 10px currentColor); }
.mk-verdict { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 17px; line-height: 1.3; color: var(--ink); text-wrap: balance; }
.mk-verdict b { font-weight: 800; }
.mk-verdict i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; vertical-align: 1px; background: var(--dot); }
.mk-presets { display: flex; flex-wrap: wrap; gap: 8px; }
.mk-preset { padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--ink-dim); font-size: 13px; font-weight: 600; cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
.mk-preset:hover { color: var(--ink); border-color: rgba(79, 229, 119, .5); }
.mk-preset[aria-pressed="true"] { color: #04160c; background: var(--citi); border-color: var(--citi); }
.mk-sliders { display: grid; gap: 12px; }
.mk-sl { display: grid; gap: 6px; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255, 255, 255, .02); }
.mk-sl-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.mk-sl label { font-size: 14px; font-weight: 600; color: var(--ink); }
.mk-sl output { font-family: var(--f-mono); font-size: 13px; color: var(--citi); font-variant-numeric: tabular-nums; min-width: 3ch; text-align: right; }
.mk-sl-notes { margin: 0; display: flex; gap: 14px; font-size: 12px; color: var(--ink-faint); }
.mk-sl-notes span { display: inline-flex; align-items: center; gap: 6px; }
.mk-sl-notes span::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--dot); }
.mk-sl input[type="range"] { width: 100%; margin: 0; accent-color: var(--citi); height: 28px; cursor: pointer; background: transparent; }
.mk-sl input[type="range"]:focus-visible { outline: 2px solid var(--citi); outline-offset: 2px; border-radius: 6px; }
.mk-fixed { margin: 0; padding: 12px 14px; border-radius: 12px; border-left: 3px solid var(--citi); background: rgba(255, 255, 255, .03); font-size: 13.5px; line-height: 1.55; color: var(--ink-dim); }

/* ---------- gráficos ---------- */
.mk-chart { position: relative; display: grid; gap: 10px; min-width: 0; }
.mk-chart h4 { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 15px; color: var(--ink); text-wrap: balance; }
.mk-chart svg { display: block; width: 100%; height: auto; max-width: 100%; overflow: visible; }
.mk-chart text { font-family: var(--f-body); fill: var(--ink-dim); }
.mk-chart .tick { font-family: var(--f-mono); font-size: 11px; fill: var(--ink-faint); }
.mk-chart .val { font-family: var(--f-mono); font-size: 12px; fill: var(--ink); font-variant-numeric: tabular-nums; }
.mk-chart .grid { stroke: var(--mk-grid); stroke-width: 1; }
.mk-chart .hit { fill: transparent; cursor: pointer; }
.mk-chart svg .mark, .mk-chart svg text, .mk-chart svg g > rect:not(.hit) { pointer-events: none; }
.mk-chart .hit:focus { outline: none; }
.mk-chart .hit:focus-visible + .mark, .mk-chart g.is-hot .mark { filter: brightness(1.25); }
.mk-src { margin: 0; font-size: 12px; color: var(--ink-faint); }
.mk-legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12.5px; color: var(--ink-dim); }
.mk-legend span { display: inline-flex; align-items: center; gap: 7px; }
.mk-legend span::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--dot); }
.mk-tip {
  position: absolute; z-index: 5; pointer-events: none; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line);
  background: rgba(6, 18, 13, .96); font-size: 12.5px; line-height: 1.45; color: var(--ink); white-space: nowrap;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .4); transform: translate(-50%, calc(-100% - 10px));
}
.mk-tip[hidden] { display: none; }
.mk-tip b { font-family: var(--f-mono); font-weight: 500; }
.mk-table { margin: 0; }
.mk-table summary { cursor: pointer; font-size: 12.5px; color: var(--ink-dim); }
.mk-table table { margin-top: 8px; border-collapse: collapse; font-size: 12.5px; font-variant-numeric: tabular-nums; }
.mk-table th, .mk-table td { padding: 5px 10px; border: 1px solid var(--line); text-align: left; }
.mk-table td.n { text-align: right; }
.mk-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 16px; }

/* ---------- visão em tela cheia ---------- */
#mk {
  position: fixed; inset: 0; z-index: 40; display: flex; flex-direction: column; background: var(--mk-bg); color: var(--ink);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); opacity: 0; transition: opacity .3s ease;
}
#mk[hidden] { display: none !important; }
#mk.is-open { opacity: 1; }
#mk button { cursor: pointer; }
.mk-top {
  flex: none; border-bottom: 1px solid var(--line); background: rgba(6, 18, 13, .9);
  padding: calc(14px + env(safe-area-inset-top, 0px)) max(20px, env(safe-area-inset-right, 0px)) 0 max(20px, env(safe-area-inset-left, 0px));
}
.mk-top-row, .mk-tabs, .mk-wrap { max-width: 1200px; margin-inline: auto; }
.mk-top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.mk-eyebrow { font-family: var(--f-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--mk-acc); }
.mk-title { font-family: var(--f-display); font-weight: 800; font-size: clamp(18px, 2.4vw, 26px); line-height: 1.15; margin: 6px 0 0; text-wrap: balance; }
.mk-top-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.mk-tabs { display: flex; gap: 4px; margin-top: 14px; overflow-x: auto; scrollbar-width: none; }
.mk-tab { padding: 14px 22px; font-family: var(--f-display); font-weight: 600; font-size: 16px; color: var(--ink-dim); border-bottom: 3px solid transparent; white-space: nowrap; }
.mk-tab:hover { color: var(--ink); }
.mk-tab[aria-selected="true"] { color: var(--ink); border-color: var(--mk-acc); }
.mk-body {
  flex: 1; overflow-y: auto; overscroll-behavior: contain;
  padding: 24px max(20px, env(safe-area-inset-right, 0px)) calc(48px + env(safe-area-inset-bottom, 0px)) max(20px, env(safe-area-inset-left, 0px));
}
.mk-wrap { display: grid; gap: 22px; }
.mk-card { min-width: 0; padding: 20px; border-radius: 16px; border: 1px solid var(--line); background: rgba(255, 255, 255, .025); }
.mk-label { margin: 0 0 10px; font-family: var(--f-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
.mk-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 16px; }
.mk-hero-main { display: grid; gap: 10px; align-content: start; background: var(--mk-acc-soft); border-color: rgba(255, 122, 138, .45); box-shadow: 0 0 44px rgba(255, 122, 138, .12); }
.mk-hero-main .mk-label { color: var(--mk-acc); }
.mk-big { margin: 0; font-family: var(--f-display); font-weight: 800; font-size: clamp(24px, 3.2vw, 34px); line-height: 1.2; text-wrap: balance; }
.mk-big mark { color: #ffd2d8; background: rgba(255, 122, 138, .16); padding: 0 .25em; border-radius: 8px; box-shadow: inset 0 0 0 1px rgba(255, 122, 138, .5); }
.mk-lead { margin: 0; font-size: 15px; color: var(--ink-dim); max-width: 62ch; }
.mk-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.mk-stat { display: grid; gap: 2px; padding: 14px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255, 255, 255, .02); }
.mk-stat b { font-family: var(--f-display); font-weight: 600; font-size: 22px; font-variant-numeric: tabular-nums; }
.mk-stat span { font-size: 12.5px; color: var(--ink-dim); }
.mk-doc-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; }
.mk-doc-bar p { margin: 0; font-size: 13.5px; color: var(--ink-dim); }

#mk :focus-visible, .mk-expand:focus-visible, .mk-btn:focus-visible, .mk-preset:focus-visible { outline: 2px solid var(--citi); outline-offset: 2px; }

@media (max-width: 760px) {
  .mk-hero, .mk-bal.is-big { grid-template-columns: 1fr; }
  .mk-tab { padding: 12px 16px; font-size: 15px; }
  .mk-pdf.is-compact { height: 320px; }
}
@media (prefers-reduced-motion: reduce) {
  .mk-beam, .mk-pan, .mk-pan .plate, #mk, .mk-expand { transition: none; }
}

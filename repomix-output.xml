    </button>
    <p class="intro-note">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 5h2.2L7.5 2.2v9.6L4.2 9H2z" fill="currentColor"/><path d="M9.6 4.6a3.4 3.4 0 0 1 0 4.8M11.2 3a5.6 5.6 0 0 1 0 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>

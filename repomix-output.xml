.dx-step .dx-medal::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--m); box-shadow: 0 0 10px var(--m); }
.dx-step strong { font-family: var(--f-display); font-weight: 600; font-size: 15px; }
.dx-step span { font-size: 13px; color: var(--ink-dim); }
.dx-step:not(:last-child)::after { content: "→"; position: absolute; right: -11px; top: 50%; transform: translateY(-50%); color: var(--ink-faint); font-size: 14px; }

/* sub-abas */
.dx-subtabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
.dx-subtab { padding: 14px 22px; font-family: var(--f-display); font-weight: 600; font-size: 16px; color: var(--ink-dim); border-bottom: 3px solid transparent; margin-bottom: -1px; white-space: nowrap; }
